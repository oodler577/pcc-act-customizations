<!doctype html>
<html lang="[% global.request.language | html %]">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>[% IF title AND title != 'Perl Community Conference' %][% title | html %] · [% END %]Perl Community Conference</title>
[% SET pcc_description = 'Perl Community Conference meets twice a year, around Perl’s birthday on December 18 and around July 4, in Austin, Texas and online. Perl talks, community, and science.' %]
[% IF meta_description %][% SET pcc_description = meta_description %][% END %]
<meta name="description" content="[% pcc_description | html %]">
[% IF canonical_path OR NOT title OR title == 'Perl Community Conference' %]
<meta name="robots" content="index,follow,max-image-preview:large">
<link rel="canonical" href="https://science.perlcommunity.org/conference/[% canonical_path | html %]">
[% ELSE %]<meta name="robots" content="noindex,follow">[% END %]
<meta property="og:site_name" content="Perl Community Conference">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_US">
<meta property="og:title" content="[% IF title AND title != 'Perl Community Conference' %][% title | html %] · [% END %]Perl Community Conference">
<meta property="og:description" content="[% pcc_description | html %]">
[% IF canonical_path OR NOT title OR title == 'Perl Community Conference' %]<meta property="og:url" content="https://science.perlcommunity.org/conference/[% canonical_path | html %]">[% END %]
<meta property="og:image" content="https://science.perlcommunity.org/conference/images/pcc-social.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Perl Community Conference — Development, Community, Science; official oyster logo">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="[% IF title AND title != 'Perl Community Conference' %][% title | html %] · [% END %]Perl Community Conference">
<meta name="twitter:description" content="[% pcc_description | html %]">
<meta name="twitter:image" content="https://science.perlcommunity.org/conference/images/pcc-social.jpg">
<meta name="twitter:image:alt" content="Perl Community Conference — Development, Community, Science; official oyster logo">
[% IF openid %]<link rel="openid.server" href="[% global.request.base_url %][% make_uri('openid') %]">[% END %]
<link rel="alternate" type="application/atom+xml" title="Conference news" href="[% global.request.base_url %][% make_uri_info('atom', global.request.language) %].xml">
<link rel="stylesheet" href="/css/act-base.css">
<link rel="stylesheet" href="/css/schedule.css">
<link rel="stylesheet" href="[% make_uri_info('css', 'style.css') %]?v=8">
<script src="/js/jquery.js"></script><script src="/js/act.js"></script>
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header"><div class="header-inner">
<a class="brand" href="[% make_uri('index.html') %]"><span class="brand-oyster" aria-hidden="true"><img src="[% make_uri_info('images', 'pcc-official-artwork.jpg') %]" alt=""></span><span><strong>Perl Community Conference</strong><small>Development · Community · Science</small></span></a>
<a class="journal-link" href="/spj">Science Perl Journal ↗</a>
</div></header>
<div class="site-layout">
<nav id="menu" aria-label="Conference navigation"><a class="nav-home" href="[% make_uri('index.html') %]">Conference home</a>[% PROCESS menu %]</nav>
<main id="content" tabindex="-1">[% IF title %]<h1 class="page-title">[% title | html %]</h1>[% END %][% content %]</main>
</div>
<footer class="site-footer"><span>Perl Community Conference</span><span>Powered by <a href="https://github.com/book/Act">Act</a></span></footer>
</body></html>
